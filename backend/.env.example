# Configuración de base de datos local (PostgreSQL)
# Asegúrate de tener PostgreSQL ejecutándose localmente.

# Host de la base de datos (usualmente localhost en desarrollo)
DB_HOST=localhost

# Puerto de PostgreSQL (por defecto 5432)
DB_PORT=5432

# Usuario de la base de datos (por defecto postgres)
DB_USER=postgres

# Contraseña de la base de datos (NO pongas tu contraseña real aquí, usa .env)
DB_PASSWORD=secret

# Nombre de la base de datos
DB_NAME=nutricion_db
